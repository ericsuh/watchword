#!/usr/bin/env bash
#MISE description="Run the package tests (Swift Testing + XCTest) and check that both frameworks ran"
#USAGE flag "--filter <pattern>" help="Only run tests matching this regex (`swift test --filter`); skips the checks that both frameworks and every adversarial suite ran, since a filter may select only some, but fails if it selects no test at all"
#USAGE flag "--coverage" help="Collect code coverage and write an llvm-cov report to coverage.txt (best effort, even if tests fail)"
#USAGE flag "--log <file>" default="test-output.log" help="Where to keep a copy of the test output"
#
# The package-tests CI job. Both frameworks must keep executing tests, not merely compiling (CLAUDE.md, "Tests"), so
# the captured output is checked for evidence of each, and for every adversarial area's suite (as `test:adversarial`
# does), which lets `check` skip a second run of that suite.
set -euo pipefail

log="$usage_log"
coverage="${usage_coverage:-false}"

args=(--parallel)
[ -n "${usage_filter:-}" ] && args+=(--filter "$usage_filter")
[ "$coverage" = true ] && args+=(--enable-code-coverage)

status=0
swift test "${args[@]}" 2>&1 | tee "$log" || status=$?

if [ "$coverage" = true ]; then
  bin=$(swift build --show-bin-path)
  profdata=$(find "$bin" -name default.profdata | head -n 1 || true)
  xctest=$(find "$bin" -maxdepth 1 -name '*.xctest' | head -n 1 || true)
  if [ -n "$profdata" ] && [ -n "$xctest" ]; then
    if [ -d "$xctest" ]; then # macOS bundle; on Linux the .xctest is the executable itself
      xcrun llvm-cov report "$xctest/Contents/MacOS/$(basename "$xctest" .xctest)" \
        -instr-profile "$profdata" -ignore-filename-regex='Tests/' > coverage.txt || true
    else
      llvm-cov report "$xctest" -instr-profile "$profdata" -ignore-filename-regex='Tests/' > coverage.txt || true
    fi
    cat coverage.txt || true
  else
    echo "warning: no coverage data found under $bin; coverage.txt not written"
  fi
fi

[ "$status" -eq 0 ] || exit "$status"

# A filter may select one framework or some suites, so the checks further down do not apply, but it must select
# something: `swift test` exits 0 with "No matching test cases were run" when a filter matches nothing.
if [ -n "${usage_filter:-}" ]; then
  grep -Eq "Test run with [1-9][0-9]* tests?|\[[0-9]+/[1-9][0-9]*\] Testing |Test Case .* passed|Executed [1-9][0-9]* tests?" "$log" \
    || { echo "::error::No tests matched --filter $usage_filter"; exit 1; }
  exit 0
fi

grep -Eq "Test run with [1-9][0-9]* tests?" "$log" \
  || { echo "::error::No Swift Testing tests were executed"; exit 1; }
# XCTest under `swift test --parallel` prints one "[n/m] Testing Target.Class/test" line per test.
grep -Eq "\[[0-9]+/[1-9][0-9]*\] Testing [A-Za-z]+Tests\.|Test Case .* passed|Executed [1-9][0-9]* tests?" "$log" \
  || { echo "::error::No XCTest tests were executed"; exit 1; }

# Every adversarial area's @Suite must have run (adversarial-suites.txt says why).
missing=0
while IFS= read -r suite; do
  case "$suite" in "" | "#"*) continue ;; esac
  grep -Fq "$suite" "$log" || { echo "::error::Adversarial suite missing: $suite"; missing=1; }
done < "$(dirname "${BASH_SOURCE[0]}")/adversarial-suites.txt"
exit "$missing"
