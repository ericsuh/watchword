#!/usr/bin/env bash
#MISE description="Run the adversarial security suite alone and check every area's suite ran"
#USAGE flag "--log <file>" default="adversarial.log" help="Where to keep a copy of the test output"
#
# The adversarial-tests CI job (docs/04-test-plan.md §6). A renamed or deleted suite would otherwise pass silently as
# "fewer tests ran", so each area's @Suite display name must appear in the output. Renaming a suite breaks this on
# purpose: update the list below alongside it.
set -euo pipefail

suites=(
  "envelope and KDF"
  "AutoFill service matching"
  "password generator"
  "phishing resistance"
  "crypto core"
  "unlock and quick unlock"
  "local vault store"
  "Keychain item protection"
)

log="$usage_log"
swift test --parallel --filter WatchwordAdversarialTests 2>&1 | tee "$log"

if grep -Eq "Test run with 0 tests|Executed 0 tests" "$log"; then
  echo "::error::No adversarial tests were executed"
  exit 1
fi
for suite in "${suites[@]}"; do
  grep -Fq "$suite" "$log" || { echo "::error::Adversarial suite missing: $suite"; exit 1; }
done
