#!/usr/bin/env bash
#MISE description="Run the adversarial security suite alone and check every area's suite ran"
#USAGE flag "--log <file>" default="adversarial.log" help="Where to keep a copy of the test output"
#
# The adversarial-tests CI job (docs/04-test-plan.md §6): the security suite on its own, so a regression shows up as
# its own red check.
set -euo pipefail

log="$usage_log"
swift test --parallel --filter WatchwordAdversarialTests 2>&1 | tee "$log"

if grep -Eq "Test run with 0 tests|Executed 0 tests" "$log"; then
  echo "::error::No adversarial tests were executed"
  exit 1
fi

# Every adversarial area's @Suite must have run (adversarial-suites.txt says why).
missing=0
while IFS= read -r suite; do
  case "$suite" in "" | "#"*) continue ;; esac
  grep -Fq "$suite" "$log" || { echo "::error::Adversarial suite missing: $suite"; missing=1; }
done < "$(dirname "${BASH_SOURCE[0]}")/adversarial-suites.txt"
exit "$missing"
