#!/usr/bin/env bash
#MISE description="Build the iOS and/or macOS app with xcodebuild, unsigned (iOS Simulator) or ad hoc signed (macOS)"
#MISE depends=["app:generate"]
#USAGE arg "[platform]" default="all" help="Which app to build" {
#USAGE   choices "ios" "macos" "all"
#USAGE }
#USAGE flag "--configuration <name>" default="Debug" help="Xcode build configuration" {
#USAGE   choices "Debug" "Release"
#USAGE }
#
# Signing matches `app:test`: CI has no provisioning profile, so iOS builds for the simulator without signing and
# macOS signs ad hoc with the entitlements dropped.
set -euo pipefail

build() { # build <scheme> <destination> <build settings...>
  local scheme="$1" destination="$2"
  shift 2
  xcodebuild build -project Apps/Watchword.xcodeproj -scheme "$scheme" -destination "$destination" \
    -configuration "$usage_configuration" "$@"
}

case "$usage_platform" in
  ios | all) build Watchword-iOS 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO ;;
esac
case "$usage_platform" in
  macos | all)
    build Watchword-macOS 'platform=macOS' \
      CODE_SIGN_IDENTITY=- CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM= CODE_SIGN_ENTITLEMENTS=""
    ;;
esac
