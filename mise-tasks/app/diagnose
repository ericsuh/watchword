#!/usr/bin/env bash
#MISE description="Print what each result bundle from app:test knows about a failure: summary, text attachments, runner logs, crash reports"
#USAGE arg "[results]" default="TestResults" help="The directory `app:test --results` wrote its .xcresult bundles to"
#
# The app-tests CI job runs this when `app:test` fails, so the job log, which anyone (or any tool) can read, carries
# what is otherwise only inside the uploaded .xcresult, readable only with Xcode's xcresulttool. A UI-test runner that
# dies before any test runs ("operation never finished bootstrapping") reports one line in xcodebuild's output; its
# own log and crash report say why. The failed tests' text attachments (the UI-test helpers attach the element tree
# and their diagnostics there) are printed too, capped so one cannot bury the rest. Last of all, after everything
# else, diagnose-summary.py prints each failed test's failure messages and last STEP lines (from app:test's copy of
# xcodebuild's output, <results>/<name>.log, and the runner's output) and one line, "UI-test summary: N passed, N
# failed: <names>", so the end of the job log says what failed and where. Informational only: it never fails, because
# the job has already failed.
set -uo pipefail

results="$usage_results"
shopt -s nullglob
bundles=("$results"/*.xcresult)
if [ ${#bundles[@]} -eq 0 ]; then
  echo "No result bundles in $results; xcodebuild failed before testing began (see the app:test step)."
  echo "UI-test summary: 0 passed, 0 failed: none (no result bundle: xcodebuild failed before testing began)"
  exit 0
fi

limit=200 # lines per file, so one runaway log cannot bury the rest
before=150 # lines of a session log shown before a UI query's timeout
show() {  # show <file>: its last $limit lines, under a heading
  echo "--- ${1#"$out"/} ($(wc -l < "$1" | tr -d ' ') lines, last $limit shown)"
  tail -n "$limit" "$1"
}

work=$(mktemp -d) # what diagnose-summary.py reads: <name>.summary.json and <name>.logs/ per bundle
for bundle in "${bundles[@]}"; do
  name=$(basename "$bundle" .xcresult)
  mkdir -p "$work/$name.logs"
  if [ -f "$results/$name.log" ]; then cp "$results/$name.log" "$work/$name.logs/xcodebuild.log"; fi

  echo "::group::$name: test summary"
  if xcrun xcresulttool get test-results summary --path "$bundle" --compact > "$work/$name.summary.json"; then
    python3 -m json.tool < "$work/$name.summary.json" || true
  else
    rm -f "$work/$name.summary.json"
    echo "::warning::xcresulttool could not read the test summary of $bundle"
  fi
  echo "::endgroup::"

  out=$(mktemp -d)
  if ! xcrun xcresulttool export diagnostics --path "$bundle" --output-path "$out" > /dev/null; then
    echo "::warning::xcresulttool could not export the diagnostics of $bundle"
    continue
  fi

  attachments=$(mktemp -d)
  # `export attachments` is Xcode 16's; `--only-failures` keeps a long passing tour's screens out of the log.
  if xcrun xcresulttool export attachments --path "$bundle" --output-path "$attachments" --only-failures > /dev/null 2>&1 \
    || xcrun xcresulttool export attachments --path "$bundle" --output-path "$attachments" > /dev/null 2>&1; then
    python3 -I "$(dirname "${BASH_SOURCE[0]}")/diagnose-attachments.py" "$attachments" "$name"
  else
    echo "::warning::this xcresulttool cannot export attachments; its export subcommands follow"
    xcrun xcresulttool export --help 2> /dev/null | head -n 20 || true
  fi
  rm -rf "$attachments"

  echo "::group::$name: diagnostic files"
  (cd "$out" && find . -type f | sort)
  echo "::endgroup::"

  # Crash reports, where a runner crash such as handleStalledWait names its faulting thread; the runner's and the
  # app's standard output; and xcodebuild's session log, where "Failed to initialize for UI testing" and simulator
  # service errors land.
  while IFS= read -r -d '' file; do
    echo "::group::$name: ${file#"$out"/}"
    show "$file"
    echo "::endgroup::"
  done < <(find "$out" -type f \( -name '*.ips' -o -name '*.crash' -o -name 'StandardOutputAndStandardError*.txt' \
    -o -name 'Session-*.log' \) -print0 | sort -z)
  # Where a UI query timed out, what the session log holds from before the first two reports of it: what XCUITest
  # saw while it waited (accessibility errors, whether the app was idle), which says whether the app or the simulator
  # was the one not answering and is long gone from the last lines shown above.
  while IFS= read -r -d '' file; do
    grep -n -m 2 'Timed out while evaluating UI query' "$file" | cut -d: -f1 | while read -r line; do
      start=$((line > before ? line - before : 1))
      echo "::group::$name: ${file#"$out"/}, lines $start to $line, before a UI query timed out"
      sed -n "${start},${line}p" "$file" | cut -c1-400
      echo "::endgroup::"
    done
  done < <(find "$out" -type f -name 'Session-*.log' -print0 | sort -z)
  # The runner's own output, where the tests' STEP lines are whatever xcodebuild echoed.
  index=0
  while IFS= read -r -d '' file; do
    index=$((index + 1))
    cp "$file" "$work/$name.logs/runner-$index.txt"
  done < <(find "$out" -type f -name 'StandardOutputAndStandardError*.txt' -print0 | sort -z)
  rm -rf "$out"
done

python3 -I "$(dirname "${BASH_SOURCE[0]}")/diagnose-summary.py" "$work"
rm -rf "$work"
exit 0
